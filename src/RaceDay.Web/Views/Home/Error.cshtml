@{
    ViewData["Title"] = "Something went wrong";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card p-4 p-md-5 text-center">
            <div class="display-1 text-navy"><i class="bi bi-activity"></i></div>
            <h1 class="h3 section-title">We hit a bump in the road</h1>
            <p class="text-muted">Something unexpected happened. Your data is safe — please try again or return to the start line.</p>
            <a class="btn btn-race" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</div>
