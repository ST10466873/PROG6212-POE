@model EventFormViewModel
@{
    var editing = Model.EventId > 0;
    ViewData["Title"] = editing ? "Edit event" : "Create event";
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card p-4 p-md-5">
            <p class="section-kicker">@(editing ? "Update your race" : "Plan your race")</p>
            <h1 class="h2 section-title mb-1">@(editing ? "Edit event" : "Create a new event")</h1>
            <p class="text-muted small mb-4">All six required fields are captured here. Banners are uploaded through the API to Azure Blob Storage.</p>
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form asp-controller="Organiser" asp-action="@(editing ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="BannerImageUrl" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cape Town 10K" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label fw-semibold"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tell participants about the route, atmosphere and what to expect."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Date" class="form-label fw-semibold"></label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="Venue or city" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DistanceKm" class="form-label fw-semibold"></label>
                        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Banner" class="form-label fw-semibold"></label>
                        <input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                        <span class="field-hint">Optional · JPG, PNG, WEBP or GIF · max 5 MB</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <div class="col-12">
                            <img src="@ImageUrlHelper.Resolve(Model.BannerImageUrl)" alt="Current banner" class="img-thumbnail" style="max-height:140px" />
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" asp-controller="Organiser" asp-action="Events">Cancel</a>
                    <button type="submit" class="btn btn-accent px-4">@(editing ? "Save changes" : "Create event")</button>
                </div>
            </form>
        </div>
    </div>
</div>
